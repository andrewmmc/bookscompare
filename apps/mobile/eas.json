{
  "cli": {
    "version": ">= 16.16.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.1"
      }
    },
    "simulator": {
      "extends": "development",
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.1",
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.1"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.1"
      }
    }
  }
}
